        "import matplotlib.pyplot as plt\n",
        "months = ['January', 'February', 'March', 'April','May']\n",
        "sales = [120,180,150,220,300]\n",
        "plt.bar(months,sales)\n",
        "plt.title('Monthly Sales')\n",
        "plt.xlabel('Month')\n",
        "plt.ylabel('Sales')\n",
        "plt.show()"
